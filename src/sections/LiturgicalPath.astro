---
import { Icon } from "astro-icon/components";

interface Season {
  number: string;
  title: string;
  text: string;
  href: string;
  color: string;
}

const seasons: Season[] = [
  {
    number: "01",
    title: "Adviento",
    text: "Nos enseña a esperar, como María esperó con confianza la llegada del Salvador.",
    href: "/tiempos/adviento",
    color: "#6f5a8c",
  },
  {
    number: "02",
    title: "Navidad",
    text: "Nos invita a recibir a Jesús, contemplándolo en los brazos de su Madre.",
    href: "/tiempos/navidad",
    color: "#c8a36a",
  },
  {
    number: "03",
    title: "Tiempo Ordinario I",
    text: "Nos ayuda a reconocer a Jesús caminando en lo cotidiano y en los pequeños gestos de amor.",
    href: "/tiempos/tiempo-ordinario",
    color: "#4f7a5c",
  },
  {
    number: "04",
    title: "Cuaresma",
    text: "Nos llama a volver el corazón a Dios y a caminar con fidelidad.",
    href: "/tiempos/cuaresma",
    color: "#6f5a8c",
  },
  {
    number: "05",
    title: "Semana Santa",
    text: "Nos invita a acompañar a Jesús en su Pasión y entrega.",
    href: "/tiempos/semana-santa",
    color: "#8c3b42",
  },
  {
    number: "06",
    title: "Pascua",
    text: "Nos recuerda que la vida vence a la muerte y que la esperanza nunca queda defraudada.",
    href: "/tiempos/pascua",
    color: "#c8a36a",
  },
  {
    number: "07",
    title: "Tiempo Ordinario II",
    text: "Nos invita a crecer en la fe y a vivir el Evangelio en las decisiones de cada día.",
    href: "/tiempos/tiempo-ordinario-2",
    color: "#4f7a5c",
  },
];

const row1 = seasons.slice(0, 4);
const row2 = seasons.slice(4);
---

<section
  id="ano-liturgico"
  class="relative grid grid-cols-[0.85fr_1.15fr] gap-[70px] bg-cream px-[clamp(24px,7vw,110px)] py-[105px] max-[900px]:grid-cols-1 max-[620px]:px-5 max-[620px]:py-[74px]"
>
  <div class="lg:sticky lg:top-45 h-max">
    <p class="mb-[26px] flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-blue">
      <span class="h-px w-[34px] bg-gold"></span>
      Un camino diario con la Palabra
    </p>
    <h2 class="m-0 mb-6 font-serif text-[clamp(38px,5vw,56px)] leading-[1.05] font-normal tracking-[-0.04em] text-navy">
      El Año Litúrgico, paso a paso.
    </h2>
    <p class="max-w-[480px] text-sm leading-[1.75] text-muted">
      El Año Litúrgico nos permite recorrer, junto con la Iglesia, los
      principales momentos de la vida de Jesús y del misterio de nuestra fe.
    </p>
  </div>

  <div>
    <div class="overflow-x-auto">
      <div class="min-w-[720px]">
        <div class="relative">
          <div class="absolute left-3.5 right-3.5 top-3.5 h-px bg-line" aria-hidden="true"></div>
          <ol class="relative grid grid-cols-4 gap-6">
            {
              row1.map((season) => (
                <li class="flex flex-col items-start">
                  <span
                    class="flex h-7 w-7 items-center justify-center rounded-full border-2 border-paper shadow-[0_0_0_1px_rgba(22,55,74,0.13)]"
                    style={`background-color:${season.color}`}
                  />
                  <span class="mt-4 text-[10px] font-bold uppercase tracking-[0.14em] text-gold">
                    {season.number}
                  </span>
                  <h3 class="m-0 mt-1.5 font-serif text-xl font-medium tracking-[-0.01em] text-navy">
                    {season.title}
                  </h3>
                  <p class="m-0 mt-2 text-sm leading-[1.6] text-muted">{season.text}</p>
                  <a
                    href={season.href}
                    class="mt-4 whitespace-nowrap border-b border-gold/50 text-xs font-semibold uppercase tracking-[0.06em] text-navy transition-colors duration-150 hover:border-gold hover:text-gold"
                  >
                    Conocer este tiempo →
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="relative mt-16">
          <div class="absolute left-3.5 right-3.5 top-3.5 h-px bg-line" aria-hidden="true"></div>
          <ol class="relative grid grid-cols-3 gap-6">
            {
              row2.map((season) => (
                <li class="flex flex-col items-start">
                  <span
                    class="flex h-7 w-7 items-center justify-center rounded-full border-2 border-paper shadow-[0_0_0_1px_rgba(22,55,74,0.13)]"
                    style={`background-color:${season.color}`}
                  />
                  <span class="mt-4 text-[10px] font-bold uppercase tracking-[0.14em] text-gold">
                    {season.number}
                  </span>
                  <h3 class="m-0 mt-1.5 font-serif text-xl font-medium tracking-[-0.01em] text-navy">
                    {season.title}
                  </h3>
                  <p class="m-0 mt-2 text-sm leading-[1.6] text-muted">{season.text}</p>
                  <a
                    href={season.href}
                    class="mt-4 whitespace-nowrap border-b border-gold/50 text-xs font-semibold uppercase tracking-[0.06em] text-navy transition-colors duration-150 hover:border-gold hover:text-gold"
                  >
                    Conocer este tiempo →
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    <div class="mt-14 flex items-start gap-4 border-t border-line pt-8">
      <Icon name="cruz" class="mt-1 h-5 w-5 flex-none text-gold" />
      <p class="m-0 max-w-[560px] text-sm leading-[1.75] text-muted">
        María permanece presente a lo largo de todo el Año Litúrgico. Ella nos enseña a escuchar, guardar y vivir la
        Palabra de Dios.
      </p>
    </div>
  </div>
</section>
