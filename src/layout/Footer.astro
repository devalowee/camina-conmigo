---
import { Icon } from "astro-icon/components";

const spotifyUrl =
  import.meta.env.PUBLIC_SPOTIFY_URL ||
  "https://open.spotify.com/show/6E0Kks0fEvCGbwy1cmpKUS";

const instagramUrl = "https://www.instagram.com/caminaconmigofe/";
const youtubeUrl = "https://www.youtube.com/@caminaconmigolabibliacatolica";

const exploraLinks = [
  { href: "#podcast", label: "Podcast" },
  { href: "#oracion", label: "Intenciones de oración" },
];

const conoceLinks = [
  { href: "#sobre-proyecto", label: "Sobre el proyecto" },
  { href: "#reflexiones", label: "Reflexiones" },
];

const oracionesLinks = [
  { href: "/oraciones/oracion-para-iniciar-el-dia", label: "Para iniciar el día" },
  { href: "/oraciones/oracion-para-fortaleza", label: "Cuando necesitas fortaleza" },
  { href: "/oraciones/oracion-para-terminar-el-dia", label: "Para terminar el día" },
  { href: "/oraciones/novena-al-espiritu-santo", label: "Novena al Espíritu Santo" },
];

const socialLinks = [
  { href: spotifyUrl, icon: "spotify", label: "Escuchar en Spotify" },
  { href: instagramUrl, icon: "instagram", label: "Camina Conmigo Fe" },
  { href: youtubeUrl, icon: "youtube", label: "La Biblia Católica" },
];
---

<footer
  class="bg-[#0b2636] px-[clamp(24px,7vw,110px)] pt-19 pb-9 text-white"
>
  <div class="grid grid-cols-[1.3fr_1fr_1fr_1fr] gap-15 max-[900px]:grid-cols-2 max-[520px]:grid-cols-1">
    <div>
      <a href="#inicio" class="inline-flex items-center gap-3.25">
        <img src="/camina-conmigo-logo.webp" alt="Camina Conmigo" class="max-h-16" />
      </a>
      <p class="mt-6 max-w-97.5 font-serif text-[15px] leading-[1.7] text-white/50">
        Un espacio para caminar juntos en la fe, alimentar el alma con la Palabra de Dios y
        crecer en oración, esperanza y amor.
      </p>
    </div>

    <div>
      <h3 class="font-serif text-2xl font-medium tracking-[-0.02em] text-white">Explora</h3>
      <Icon name="ornamento" class="mt-3 h-3.5 w-27 text-gold" />
      <div class="mt-6 flex flex-col gap-4">
        {
          exploraLinks.map((link) => (
            <a href={link.href} class="text-sm text-white/70">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h3 class="font-serif text-2xl font-medium tracking-[-0.02em] text-white">Conoce</h3>
      <Icon name="ornamento" class="mt-3 h-3.5 w-27 text-gold" />
      <div class="mt-6 flex flex-col gap-4">
        {
          conoceLinks.map((link) => (
            <a href={link.href} class="text-sm text-white/70">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h3 class="font-serif text-2xl font-medium tracking-[-0.02em] text-white">Oraciones</h3>
      <Icon name="ornamento" class="mt-3 h-3.5 w-27 text-gold" />
      <div class="mt-6 flex flex-col gap-4">
        {
          oracionesLinks.map((link) => (
            <a href={link.href} class="text-sm text-white/70">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div
    class="mt-14 flex flex-wrap items-center justify-center gap-x-11 gap-y-5 border-t border-white/10 pt-7"
  >
    {
      socialLinks.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-3 text-sm text-white/80 transition-colors hover:text-gold"
        >
          <Icon name={social.icon} class="h-7 w-7 shrink-0 text-white" />
          {social.label}
        </a>
      ))
    }
  </div>

  <div class="mt-10 flex flex-col items-center gap-3 text-center">
    <Icon name="ornamento" class="h-3.5 w-27 text-gold" />
    <span class="text-[11px] uppercase tracking-[0.12em] text-white/34" id="current-year">
      © 2026 Camina Conmigo
    </span>
  </div>
</footer>

<script>
  const yearElement = document.getElementById("current-year");
  if (yearElement) {
    yearElement.textContent = `© ${new Date().getFullYear()} Camina Conmigo`;
  }
</script>